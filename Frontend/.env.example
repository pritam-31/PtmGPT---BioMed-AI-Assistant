# Frontend configuration. Copy to `.env` (optional).

# Base URL of the Node backend.
VITE_API_BASE_URL=http://localhost:8080

# UPI payment details shown in the upgrade modal.
# Leave VITE_UPI_ID empty to hide the payment QR section.
# Payments are NOT processed by this app; plans are granted manually by an admin.
VITE_UPI_ID=
VITE_UPI_MERCHANT_NAME=PtmGPT
