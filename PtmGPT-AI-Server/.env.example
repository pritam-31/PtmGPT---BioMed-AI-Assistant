# Copy to `.env` and fill in real values. Never commit `.env`.

# Hugging Face model id used by ai_server.py (gated model).
# Leave empty to auto-use the local ./model folder when it exists, otherwise
# the server falls back to google/medgemma-4b-it.
MEDGEMMA_MODEL_ID=

# Optional override for the local model folder (defaults to ./model).
MEDGEMMA_LOCAL_MODEL_DIR=

# Where to place the model weights. On a CPU-only install this defaults to
# "cpu" automatically (using "auto" without CUDA makes accelerate offload
# weights to disk, which crashes generation with meta-tensor errors).
# Values: cpu | cuda | auto | mps
MEDGEMMA_DEVICE=

# Optional weight dtype override, useful to save RAM on CPU.
# Values: bf16 | fp16 (leave empty to use the checkpoint dtype, bf16).
MEDGEMMA_DTYPE=

# Hugging Face access token, required to download the gated MedGemma weights.
# Accept the license first at https://huggingface.co/google/medgemma-4b-it
HF_TOKEN=

# ---- PDF pipeline ----------------------------------------------------------
# OCR for scanned PDF pages. Requires the Tesseract binary to be installed.
OCR_ENABLED=true
OCR_LANG=eng

# Limits to keep memory and latency reasonable.
MAX_PDF_PAGES=10
MAX_PDF_IMAGES=4
MAX_PDF_TEXT_CHARS=12000
MAX_NEW_TOKENS=768
