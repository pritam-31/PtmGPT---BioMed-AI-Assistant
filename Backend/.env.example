# ---------------------------------------------------------------------------
# Backend configuration. Copy to `.env` and fill in real values.
# Never commit your real `.env`.
# ---------------------------------------------------------------------------

# Server
PORT=8080
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS).
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# MongoDB connection string (Atlas or local).
MONGODB_URI=mongodb://127.0.0.1:27017/test

# Session signing secret. REQUIRED when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ---- Cloud mode (OpenAI) ---------------------------------------------------
OPENAI_API_KEY=
# Model id used for cloud chat. Verify it is available in your OpenAI account.
OPENAI_MODEL=gpt-4o-mini
# How many previous messages to include as conversation context.
OPENAI_HISTORY_MESSAGES=10

# ---- Local mode (Python AI service) ---------------------------------------
LOCAL_AI_URL=http://127.0.0.1:8001/analyze
LOCAL_AI_HEALTH_URL=http://127.0.0.1:8001/health

# ---- Image storage (optional) ---------------------------------------------
# Leave blank to fall back to local disk storage under ./uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Plans / payments (stub only) -----------------------------------------
# Comma-separated admin emails allowed to grant plans via the admin route.
ADMIN_EMAILS=
# Shared secret required by the stub payment webhook. Leave blank to disable.
PAYMENT_WEBHOOK_SECRET=
